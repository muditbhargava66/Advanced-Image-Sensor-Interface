# ==============================================================================
# Advanced Image Sensor Interface — .gitignore
# ==============================================================================

# ---- Python Byte-compiled / Optimized / DLL files ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Distribution / Packaging ----
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.whl
pip-wheel-metadata/

# ---- PyInstaller ----
*.manifest
*.spec

# ---- Installer logs ----
pip-log.txt
pip-delete-this-directory.txt

# ---- Unit test / coverage reports ----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
nosetests.xml

# ---- Translations ----
*.mo
*.pot

# ---- Sphinx documentation ----
docs/_build/
docs/build/

# ---- PyBuilder ----
.pybuilder/
target/

# ---- Jupyter Notebook / IPython ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---- Python environment managers ----
.python-version
Pipfile.lock
poetry.lock
pdm.lock
.pdm.toml
__pypackages__/

# ---- Environments ----
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.env.local
.env.production

# ---- Celery ----
celerybeat-schedule
celerybeat.pid

# ---- SageMath ----
*.sage.py

# ---- Type checkers / linters ----
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ---- Cython debug symbols ----
cython_debug/

# ---- IDEs & Editors ----
.idea/
.vscode/
.vim/
.emacs.d/
*.xcodeproj/
*.xcworkspace/
.spyderproject
.spyproject
.ropeproject

# ---- OS generated files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Logs ----
*.log

# ---- mkdocs ----
/site

# ==============================================================================
# Project-specific — Advanced Image Sensor Interface
# ==============================================================================

# ---- Data / Model / Image artifacts ----
*.sqlite
*.hdf5
*.pkl
*.npy
*.npz
*.jpg
# *.png  (keep PNGs — needed for assets/)
*.tif
*.tiff
*.raw
*.dng
*.cr2
*.nef
*.arw
output/
data/raw/
data/processed/
models/
results/
calibration_data/
sensor_configs/
temp_images/

# ---- Benchmark / Test outputs ----
benchmark_results.json
*_results.json
test_sim.json
final_test.json
performance_*.json
profiling_*.json

# ---- Keep requirements files ----
!requirements.txt
!requirements-dev.txt
!requirements-full.txt

# ---- Temporary files ----
*.swp
*.swo
*~
*.tmp
*.temp

# ---- Large / compressed files ----
*.zip
*.tar.gz
*.rar
*.7z

# ---- Sensitive / personal files ----
config.ini
secrets.yaml
api_keys.txt

# ---- GPU / CUDA ----
*.ptx
*.cubin
*.fatbin

# ---- Hardware simulation ----
*.vcd
*.ghw
*.fst

# ---- Migration / legacy (v3.0.0) ----
v2_migration_backup/
legacy_configs/
deprecated/

# ---- CI/CD artifacts ----
.github/workflows/artifacts/
ci_logs/
deployment_logs/